+{% extends "base.html" %}
+{% block title %}New case{% endblock %}
+{% block content %}
+<h1>New case</h1>
+<form method="post" action="/cases" class="card grid two">
+  <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
+  <div style="grid-column:1/-1">
+    <label for="client_id">Company &mdash; from the client master</label>
+    <select id="client_id" name="client_id">
+      <option value="">(not in the master &mdash; type the details below)</option>
+      {% for c in clients %}<option value="{{ c.id }}">{{ c.name }}{% if c.code %} [{{ c.code }}]{% endif %}</option>{% endfor %}
+    </select>
+    {% if not clients %}<div class="muted">The client master is empty.
+      {% if user.is_admin %}<a href="/admin">Add a company</a>{% else %}Ask an administrator to add your companies.{% endif %}</div>{% endif %}
+  </div>
+  <div><label for="sub_group_id">Sub-group</label>
+    <select id="sub_group_id" name="sub_group_id"><option value="">(none)</option></select></div>
+  <div><label for="legal_entity_id">Legal entity</label>
+    <select id="legal_entity_id" name="legal_entity_id"><option value="">(none)</option></select></div>
+  <div style="grid-column:1/-1"><label for="client_policy_id">Insurer policy</label>
+    <select id="client_policy_id" name="client_policy_id"><option value="">(none)</option></select></div>
+
+  <div><label for="client_name">Client (free text, when not in the master)</label><input type="text" id="client_name" name="client_name"></div>
+  <div><label for="sub_group">Sub-group (free text)</label><input type="text" id="sub_group" name="sub_group"></div>
+  <div><label for="insurer">Insurer / TPA (free text)</label><input type="text" id="insurer" name="insurer"></div>
+  <div><label for="policy_no">Policy no.</label><input type="text" id="policy_no" name="policy_no"></div>
+  <div><label for="contract_name">Contract name</label><input type="text" id="contract_name" name="contract_name"></div>
+  <div><label for="category">Category</label><input type="text" id="category" name="category"></div>
+  <div>
+    <label for="transaction_type">Transaction type *</label>
+    <select id="transaction_type" name="transaction_type">
+      <option value="addition">Addition</option>
+      <option value="deletion">Deletion</option>
+    </select>
+  </div>
+  <div>
+    <label for="template_key">Output template</label>
+    <select id="template_key" name="template_key">
+      <option value="">Choose at export</option>
+      {% for key in templates_available %}<option value="{{ key }}">{{ key }}</option>{% endfor %}
+    </select>
+  </div>
+  <div><label for="email_subject">Email subject</label><input type="text" id="email_subject" name="email_subject"></div>
+  <div><label for="email_received_date">Email received</label><input type="datetime-local" id="email_received_date" name="email_received_date"></div>
+  <div style="grid-column:1/-1">
+    <label for="bms_comments">BMS Comments &mdash; paste the client email body</label>
+    <textarea id="bms_comments" name="bms_comments" placeholder="Paste the relevant client email body here. The platform never reads a mailbox."></textarea>
+  </div>
+  <div style="grid-column:1/-1"><button type="submit">Create case</button> <a class="btn secondary" href="/">Cancel</a></div>
+</form>
+<script src="/static/case_new.js" defer></script>
+{% endblock %}
