# BMS Medical Endorsement Platform -- deployment configuration.
#
# Copy to .env next to the application and edit. Every value has a working
# default except BMS_SECRET_KEY, which must be set.

# --- database -------------------------------------------------------------
# SQLite is adequate for a single-user prototype. Use PostgreSQL for shared use.
BMS_DATABASE_URL=sqlite:///./bms_prototype.db
# BMS_DATABASE_URL=postgresql+psycopg://bms:CHANGE_ME@localhost/bms

# --- storage --------------------------------------------------------------
# Uploads, generated workbooks and ZIPs. Back this up with the database.
BMS_DATA_ROOT=./var
# Where the immutable insurer templates live. Read-only; never written to.
BMS_TEMPLATE_ROOT=..

# --- security -------------------------------------------------------------
# REQUIRED. Signs the session cookie. Without it a new key is generated at every
# start, so every restart signs all users out.
#   Linux:    openssl rand -base64 48
#   Windows:  [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
BMS_SECRET_KEY=CHANGE_ME

# Set true once the platform is behind TLS: the session cookie is then never
# sent in the clear, and HSTS is advertised. Leave false on plain HTTP -- a
# secure cookie over HTTP is simply never sent, which locks everyone out.
BMS_COOKIE_SECURE=false

# Password for the initial administrator, created on first start only.
#
# LEAVE THIS COMMENTED OUT. With no value set, the platform generates a strong
# random password on first start and prints it to the console ONCE -- which is
# what you want. Setting a literal here would ship the same known password to
# every installation, and would leave it sitting in this file in plain text.
#
# If you miss the printed password, reset it on the host with:
#   python -m bms.cli reset-password --username bms
#
# BMS_SEED_PASSWORD=

# --- retention ------------------------------------------------------------
# Hours after a case is CLOSED before its documents and generated files are
# deleted. Case records, member rows, log entries and the audit trail are kept
# indefinitely regardless.
BMS_DOCUMENT_RETENTION_HOURS=36
BMS_PURGE_ENABLED=true
# How often the in-process purge runs. 0 disables it if you prefer your own
# scheduler calling: python -m bms.cli purge
BMS_PURGE_INTERVAL_MINUTES=60

# --- local OCR ------------------------------------------------------------
# All processing is local. No document is ever sent to an external service.
BMS_OCR_ENABLED=true
# LEAVE THIS COMMENTED OUT unless you have Tesseract somewhere unusual.
# It is the highest-priority setting, so a value here overrides — and silently
# disables — a copy bundled at vendor/tesseract/. Unset, the platform finds a
# bundled copy first and falls back to PATH, which is what you want.
# BMS_TESSERACT_CMD=tesseract
# Windows example:
# BMS_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
BMS_OCR_LANGUAGES=eng+ara

# --- limits ---------------------------------------------------------------
BMS_MAX_UPLOAD_BYTES=67108864
BMS_MAX_ARCHIVE_MEMBERS=500
BMS_MAX_ARCHIVE_BYTES=536870912
